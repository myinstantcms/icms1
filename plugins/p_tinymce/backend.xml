<?xml version="1.0" encoding="utf-8"?>
<backend>
    <info>
        <type>plugin</type>
        <id>p_tinymce</id>
    </info>
    <params>
        <param type="list_db" multiple="1" name="upload_for_groups" src="cms_user_groups" src_title="title" src_value="id" src_where="alias &lt;&gt; 'guest'" />
        <param type="list_db" multiple="1" name="upload_file_for_groups" src="cms_user_groups" src_title="title" src_value="id" src_where="alias &lt;&gt; 'guest'" />
        <param type="string" name="allow_file_ext" default="" />
        <param type="number" name="photo_width" default="600" units="px" />
        <param type="number" name="photo_height" default="600" units="px" />
        <param type="flag" name="iswatermark" default="off" />
        <param type="list" name="skin">
            <option value="tinymce-5" />
            <option value="oxide" />
            <option value="tinymce-5-dark" />
            <option value="oxide-dark" />
        </param>
    </params>
</backend>
